# MapMyRoad environment variables (DEPLOYMENT.md section 8, SECURITY.md section 10).
#
# Copy to infra/.env and fill in values. infra/.env is git-ignored and must never be committed.
# On the production VM it lives at /opt/rq/compose/.env, owned by root, mode 600.
# Every value below is a PLACEHOLDER. Do not reuse them anywhere real.
#
# Keep values free of quotes and spaces: the same file is read by Docker Compose and by infra/scripts/*.sh.

# --- Database container (postgis) ---------------------------------------------------------------
# Superuser created by the postgis image on first start (only when the data volume is empty).
POSTGRES_USER=roadquality
POSTGRES_PASSWORD=change-me-local-only

# --- Database connection used by the API --------------------------------------------------------
# Local bootRun connects through the loopback port published by docker-compose.dev.yml.
# The compose files override DB_URL with jdbc:postgresql://db:5432/roadquality inside the Docker network.
# TODO(M4-5): split roles per DATABASE_SCHEMA.md A13 (rq_migrator for Flyway, rq_app for the API).
# Until then, locally DB_USER/DB_PASSWORD may equal POSTGRES_USER/POSTGRES_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5432/roadquality
DB_USER=roadquality
DB_PASSWORD=change-me-local-only
# Host port for the dev database (docker-compose.dev.yml only). Change if 5432 is already taken.
DB_PORT_LOCAL=5432

# --- API runtime ---------------------------------------------------------------------------------
# Actuator management port (ADR-0015). Internal only: never publish or proxy it.
MANAGEMENT_SERVER_PORT=8081

# Access-token signing keys, newest first: kid1:base64secret[,kid2:base64secret]
# Each secret is 32 random bytes, base64 encoded. Generate one with:
#   openssl rand -base64 32
# Rotation (DEPLOYMENT.md section 12.7): put the new key first, deploy, wait for the token lifetime
# plus margin, then remove the old key.
# Local development: leave empty and the `local` profile generates a temporary key at startup
# (tokens stop working after a restart). Production must set it, for example:
#   JWT_KEYS=k1:<output of openssl rand -base64 32>
JWT_KEYS=

# Path INSIDE the API container to the Play Integrity service account JSON. Production mounts the
# key read-only via a Compose secret (docker-compose.yml). Leave empty locally (integrity is not
# enforced in the local profile).
PLAY_INTEGRITY_SA_FILE=

# Supported region as minLon,minLat,maxLon,maxLat (API_SPEC.md section 5.1). Illustrative default.
SUPPORTED_REGION_BBOX=72.6,17.9,75.1,19.6
# Oldest app version the API accepts (semantic version). Raise only when truly necessary (DEPLOYMENT.md 7.4).
MIN_SUPPORTED_APP_VERSION=1.0.0
# Ingestion kill switch (DEPLOYMENT.md sections 12.2 and 12.4).
UPLOADS_ENABLED=true

# TODO(M4-2): upstream services.
# VALHALLA_URL=http://valhalla:8002
# PHOTON_URL=

# --- Production only -----------------------------------------------------------------------------
# Image tag of ghcr.io/OWNER/mmr-api to run. Managed by scripts/deploy.sh and scripts/rollback.sh.
API_TAG=0.1.0
# Public hostname served by Caddy (TLS certificate is requested for it) and used by smoke checks.
API_DOMAIN=api.example.com

# --- Backups (production only, DEPLOYMENT.md section 9) ------------------------------------------
# S3-compatible object storage (Cloudflare R2 or Oracle Object Storage). Use a key scoped to one bucket.
BACKUP_BUCKET=mmr-backups
BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# rclone S3 provider name, for example Cloudflare or Other.
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_KEY_ID=REPLACE_ME
BACKUP_KEY=REPLACE_ME
# age PUBLIC key (age1...). The matching private key stays offline, never on the VM.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_KEY
# Optional URL pinged after a successful backup (free heartbeat monitor). Leave empty to disable.
BACKUP_HEARTBEAT_URL=
