# Pilot area for the OSM data pipeline (M4-2, M4-3). Read by infra/scripts/osm-*.sh and valhalla-build.sh.
# Plain KEY=value lines, no quotes, no spaces: the scripts parse this file with grep, they never source it.
# Any key can be overridden by an environment variable of the same name.

# Pilot bounding box as minLon,minLat,maxLon,maxLat. Keep it identical to SUPPORTED_REGION_BBOX in
# infra/.env (what GET /v1/config returns, API_SPEC.md 5.1), so the API never accepts uploads for roads
# that are missing from osm_way or the Valhalla tiles. Illustrative default around Pune and Mumbai.
PILOT_BBOX=72.6,17.9,75.1,19.6

# Geofabrik sub-region extract that contains the whole pilot bbox (Maharashtra is in India "western-zone").
# VERIFY against https://download.geofabrik.de/asia/india.html before the first production run: the
# sub-region names and URLs could not be checked from the environment that wrote this file.
# Geofabrik publishes <file>.md5 next to every extract; osm-download.sh refuses a file that does not match.
GEOFABRIK_URL=https://download.geofabrik.de/asia/india/western-zone-latest.osm.pbf

# Tiny extract for local development and CI (a few km around central Pune: Shivajinagar, Deccan, Swargate).
# Builds Valhalla tiles and the osm2pgsql import in seconds to a few minutes. Used with --area dev.
DEV_BBOX=73.82,18.49,73.88,18.54
