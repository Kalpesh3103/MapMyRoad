<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only (SECURITY.md sections 6.1 and 8). -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
