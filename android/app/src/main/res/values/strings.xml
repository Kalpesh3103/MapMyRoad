  <!-- Privacy and data (S11), mirrors PRD section 8.1 for v1 -->
  <string name="privacy_title">Privacy and data</string>
  <string name="privacy_collected_title">What MapMyRoad collects</string>
  <string name="privacy_location_title">Location during trips</string>
  <string name="privacy_location_body">Used to record your route and place bumps on your map. Location is only recorded while a trip is running.</string>
  <string name="privacy_motion_title">Motion sensors</string>
  <string name="privacy_motion_body">Processed on your phone to detect bumps. Raw sensor data is never stored or sent.</string>
  <string name="privacy_on_phone_title">Your trips stay on this phone</string>
  <string name="privacy_on_phone_body">In this version, trips, routes and bumps are stored only on this phone. Nothing is uploaded or shared.</string>
  <string name="privacy_diagnostics_title">Crash reports and usage statistics</string>
  <string name="privacy_diagnostics_body">Help us fix problems and improve the app. They never contain your precise location.</string>
  <string name="privacy_no_account_title">No account</string>
  <string name="privacy_no_account_body">No sign-in, email or phone number is needed.</string>
  <string name="privacy_policy_link">Read the privacy policy</string>
  <string name="privacy_delete_title">Delete my data</string>
  <string name="privacy_delete_body">Removes all your trips, bumps and settings from this phone. You will see the welcome screens again.</string>
  <string name="privacy_delete_blocked_by_trip">Stop the current trip before deleting your data.</string>
  <string name="privacy_delete_button">Delete all data</string>
  <string name="privacy_deleting">Deleting…</string>
  <string name="privacy_delete_dialog_title">Delete all data?</string>
  <string name="privacy_delete_dialog_body">This deletes all trips, routes, recorded bumps and potholes, and settings on this phone. Nothing has been shared, so nothing is stored anywhere else. This can\'t be undone.</string>
  <string name="privacy_delete_confirm">Delete everything</string>

  <!-- Battery guidance (PRD PV-5) -->
  <string name="battery_title">Battery guidance</string>
  <string name="battery_intro">Some phones stop apps in the background to save battery, which can end a trip early. These steps let MapMyRoad keep recording when the screen is off.</string>
  <!-- %1$d is the step number -->
  <string name="battery_step_number">%1$d.</string>
  <string name="battery_step_1">Tap Open battery settings below.</string>
  <string name="battery_step_2">If you only see some apps, switch the list to All apps.</string>
  <string name="battery_step_3">Find MapMyRoad in the list.</string>
  <string name="battery_step_4">Choose Don\'t optimize (on some phones: Unrestricted or No restrictions).</string>
  <string name="battery_manufacturer_note">Some brands add their own setting, often called Auto-start, Background activity or App launch. If trips still stop early, allow MapMyRoad there too.</string>
  <string name="battery_open_settings">Open battery settings</string>

