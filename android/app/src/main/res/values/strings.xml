  <!-- Permission rationale (UI_UX_GUIDELINES.md S1 table) and permission denied states (section 8) -->
  <string name="permission_location_title">See where the road is rough</string>
  <string name="permission_location_body">We use your location during trips to place bumps on the map. It is only recorded while a trip is running.</string>
  <string name="permission_location_denied_title">Location is off</string>
  <string name="permission_location_denied_body">Trips can\'t be recorded without precise location. You can still explore the app, and turn location on any time in system settings.</string>
  <string name="permission_notifications_title">Know when a trip is recording</string>
  <string name="permission_notifications_body">Android requires a notification while we record. It also gives you a Stop button.</string>
  <string name="permission_notifications_denied_title">Notifications are off</string>
  <string name="permission_notifications_denied_body">Trips still record, but you won\'t see the recording notification or its Stop button. You can turn notifications on any time in system settings.</string>
  <string name="permission_open_settings">Open system settings</string>

