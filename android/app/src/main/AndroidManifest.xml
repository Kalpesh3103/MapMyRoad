<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Map tiles now, API in v2 (TECH_STACK.md section 3.3). -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Trip recording (M2-2, TECH_STACK.md section 3.3): precise location in the foreground service while a trip is
       active, and the persistent recording notification. No background location and no activity recognition:
       manual trips need neither. TODO(M2-14): auto-start would add ACTIVITY_RECOGNITION and background location,
       opt-in only. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Backups are fully disabled and excluded (SECURITY.md section 8): trips contain precise locations. -->
  <application
    android:name=".MapMyRoadApp"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.MapMyRoad"
    tools:targetApi="31">

    <!-- The launcher activity is the only exported component. -->
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:theme="@style/Theme.MapMyRoad">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Trip tracking (M2-2). Not exported (SECURITY.md section 8): only the app's own Intents reach it. -->
    <service
      android:name=".sensing.TripTrackingService"
      android:exported="false"
      android:foregroundServiceType="location" />
  </application>

</manifest>
