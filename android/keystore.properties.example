# Copy to android/keystore.properties (git-ignored) and fill in real values. Never commit the real file
# or the keystore. CI uses the MMR_KEYSTORE_FILE, MMR_KEYSTORE_PASSWORD, MMR_KEY_ALIAS and MMR_KEY_PASSWORD
# environment variables instead. Without either, the release build is left unsigned.
# storeFile is resolved relative to the android/ directory unless it is an absolute path.
storeFile=../keystores/mapmyroad-upload.jks
storePassword=CHANGE_ME
keyAlias=mapmyroad-upload
keyPassword=CHANGE_ME
